{
  "name": "politics-uk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude .claude/**",
    "data:fetch-boundaries": "node scripts/data/fetch-commons-boundaries.mjs",
    "data:simplify-boundaries": "mapshaper src/data/scenarios/uk-2025-01-01/boundaries.commons.json -simplify 10% keep-shapes -o format=topojson force src/data/scenarios/uk-2025-01-01/boundaries.commons.json",
    "data:fetch-composition": "node scripts/data/fetch-commons-composition.mjs",
    "data:fetch-results-breakdown": "node scripts/data/fetch-commons-results-breakdown.mjs",
    "data:fetch-demographics": "node scripts/data/fetch-commons-demographics.mjs",
    "data:fetch-holyrood-boundaries": "node scripts/data/fetch-holyrood-boundaries.mjs",
    "data:fetch-holyrood-composition": "node scripts/data/fetch-holyrood-composition.mjs",
    "data:fetch-senedd-boundaries": "node scripts/data/fetch-senedd-boundaries.mjs",
    "data:fetch-senedd-composition": "node scripts/data/fetch-senedd-composition.mjs",
    "data:fetch-ni-assembly-composition": "node scripts/data/fetch-ni-assembly-composition.mjs",
    "data:derive-ni-assembly-boundaries": "node scripts/data/derive-ni-assembly-boundaries.mjs",
    "data:fetch-london-assembly-boundaries": "node scripts/data/fetch-london-assembly-boundaries.mjs",
    "data:fetch-london-assembly-composition": "node scripts/data/fetch-london-assembly-composition.mjs",
    "data:fetch-london-constituencies": "node scripts/data/fetch-london-constituencies.mjs",
    "data:fetch-mayors": "node scripts/data/fetch-mayors.mjs",
    "data:fetch-councils": "node scripts/data/fetch-council-composition.mjs",
    "data:simplify-council-boundaries": "mapshaper src/data/scenarios/uk-2025-01-01/boundaries.councils.json -simplify 10% keep-shapes -o format=topojson force src/data/scenarios/uk-2025-01-01/boundaries.councils.json",
    "data:simplify-council-ward-boundaries": "mapshaper src/data/scenarios/uk-2025-01-01/boundaries.council_wards.json -simplify 10% keep-shapes -o format=topojson force src/data/scenarios/uk-2025-01-01/boundaries.council_wards.json",
    "data:fetch-pcc-composition": "node scripts/data/fetch-pcc-composition.mjs",
    "data:build-regional-boundaries": "node scripts/data/build-regional-boundaries.mjs",
    "data:fetch-lords-composition": "node scripts/data/fetch-lords-composition.mjs",
    "data:build-parties": "node scripts/data/build-parties.mjs",
    "data:build-scenario": "node scripts/data/build-scenario.mjs",
    "validate:data": "node scripts/data/validate-scenario.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "pinia": "^3.0.4",
    "proj4": "^2.8.0",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.12.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "mapshaper": "^0.7.29",
    "tailwindcss": "^4.3.1",
    "topojson-server": "^3.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.2.8",
    "xlsx": "^0.18.5"
  }
